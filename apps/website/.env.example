# Firebase web config (Firebase console → Project settings → Your apps → Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=svr-maths-academy.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=svr-maths-academy
VITE_FIREBASE_STORAGE_BUCKET=svr-maths-academy.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Set to "true" to use the local Firebase emulators
VITE_USE_EMULATORS=false
# Google Analytics 4 measurement id (optional)
VITE_GA_ID=
# Public site URL used for canonical links / SEO
VITE_SITE_URL=https://svrmathsacademy.in
# Fallback WhatsApp number (digits with country code) used until settings/public is seeded
VITE_WHATSAPP=919000000000
